# PulseWatch Local & Cloud Deployment Configuration

# Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch_secret
DATABASE_URL=postgresql://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch

# Security
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ingestion Constraints & Rate Limiting
RATE_LIMIT_PER_MINUTE=1200
MAX_INGEST_BATCH_SIZE=500
MAX_LOG_MESSAGE_LENGTH=10000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Optional SMTP Email Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@pulsewatch.dev
