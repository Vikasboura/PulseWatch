ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsewatch
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MINUTE=1200
MAX_INGEST_BATCH_SIZE=500
MAX_LOG_MESSAGE_LENGTH=10000

# SMTP / Email Alerts (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@pulsewatch.dev
